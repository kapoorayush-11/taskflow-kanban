# Supabase connection — copy this file to `.env` and fill in your values.
# Find both in your Supabase project: Settings → API.
#
# The anon (public) key is SAFE to expose in the client bundle — access is
# controlled by Row Level Security in the database. Never put the service_role
# key here.
#
# Leave these unset to run the app in local-only mode (localStorage, no sharing).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
